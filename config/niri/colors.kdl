layout {
	background-color "#0e1415"

    focus-ring {
        active-color "#b1cbce"
        inactive-color "#899393"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#80d4dc"
        inactive-color "#899393"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#80d4dc80"
    }
}

overview {
	backdrop-color "#0e1415"
}
