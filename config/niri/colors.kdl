layout {
	background-color "#0f1417"

    focus-ring {
        active-color "#b4cad5"
        inactive-color "#8a9297"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#8ad0ef"
        inactive-color "#8a9297"
        urgent-color   "#ffb4ab"
    }

