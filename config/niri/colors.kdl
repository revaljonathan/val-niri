layout {
	background-color "#121318"

    focus-ring {
        active-color "#c2c5dd"
        inactive-color "#95959f"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#b6c4ff"
        inactive-color "#95959f"
