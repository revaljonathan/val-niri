layout {
	background-color "#121318"

    focus-ring {
        active-color "#bfc6dc"
        inactive-color "#8e9099"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#aec6ff"
        inactive-color "#8e9099"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aec6ff80"
    }
}

overview {
	backdrop-color "#121318"
}
