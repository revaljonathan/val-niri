layout {
	background-color "#0f1416"

    focus-ring {
        active-color "#b2cbd2"
        inactive-color "#899295"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#84d2e5"
        inactive-color "#899295"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#84d2e5"
        inactive-color "#0f1416e6"
        urgent-color   "#ffb4ab"
    }
    insert-hint {
        color "#84d2e580"
    }
}
overview {
	backdrop-color "#0f1416"
}

recent-windows {
    highlight {
        active-color "#84d2e5"
        urgent-color "#ffb4ab"
    }
}
