layout {
	background-color "#151312"

    focus-ring {
        active-color "#d2c4bd"
        inactive-color "#9b8e88"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#dbc1b4"
        inactive-color "#9b8e88"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#dbc1b4"
        inactive-color "#151312e6"
        urgent-color   "#ffb4ab"
    }
    insert-hint {
        color "#dbc1b480"
    }
}
overview {
	backdrop-color "#151312"
}

recent-windows {
    highlight {
        active-color "#dbc1b4"
        urgent-color "#ffb4ab"
    }
}
