layout {
	background-color "#101418"

    focus-ring {
        active-color "#bac8db"
        inactive-color "#8c9199"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#9ecafc"
        inactive-color "#8c9199"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9ecafc"
        inactive-color "#101418e6"
        urgent-color   "#ffb4ab"
    }
    insert-hint {
        color "#9ecafc80"
    }
}
overview {
	backdrop-color "#101418"
}

recent-windows {
    highlight {
        active-color "#9ecafc"
        urgent-color "#ffb4ab"
    }
}
