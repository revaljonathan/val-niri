layout {
	background-color "#101417"

    focus-ring {
        active-color "#b6c9d8"
        inactive-color "#8b9198"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#92cef6"
        inactive-color "#8b9198"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#92cef6"
        inactive-color "#101417e6"
        urgent-color   "#ffb4ab"
    }
    insert-hint {
        color "#92cef680"
    }
}
overview {
	backdrop-color "#101417"
}

recent-windows {
    highlight {
        active-color "#92cef6"
        urgent-color "#ffb4ab"
    }
}
