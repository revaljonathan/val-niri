layout {
	background-color "#19120c"

    focus-ring {
        active-color "#e3c0a5"
        inactive-color "#9e8e82"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#ffb77a"
        inactive-color "#9e8e82"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb77a80"
    }
}

overview {
	backdrop-color "#19120c"
}
