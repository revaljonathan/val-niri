layout {
	background-color "#0f1416"

    focus-ring {
        active-color "#b3cad4"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#88d1ec"
        inactive-color "#8a9296"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#88d1ec80"
    }
}

overview {
	backdrop-color "#0f1416"
}
