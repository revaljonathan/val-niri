layout {
	background-color "#131318"

    focus-ring {
        active-color "#c7c4dc"
        inactive-color "#97959f"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#c4c0ff"
        inactive-color "#97959f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#c4c0ff80"
    }
}

overview {
	backdrop-color "#131318"
}
