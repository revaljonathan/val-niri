layout {
	background-color "#141218"

    focus-ring {
        active-color "#ccc2db"
        inactive-color "#948f99"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#d1bcfd"
        inactive-color "#948f99"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#d1bcfd"
        inactive-color "#141218e6"
        urgent-color   "#ffb4ab"
    }
    insert-hint {
        color "#d1bcfd80"
    }
}
overview {
	backdrop-color "#141218"
}

recent-windows {
    highlight {
        active-color "#d1bcfd"
        urgent-color "#ffb4ab"
    }
}
