layout {
	background-color "#121318"

    focus-ring {
        active-color "#c3c5dd"
        inactive-color "#96959f"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#b9c3ff"
        inactive-color "#96959f"
