layout {
	background-color "#121318"

    focus-ring {
        active-color "#bfc6dc"
        inactive-color "#8f9099"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#afc6ff"
        inactive-color "#8f9099"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#afc6ff80"
    }
}

overview {
	backdrop-color "#121318"
}
