layout {
	background-color "#101418"

    focus-ring {
        active-color "#b9c8da"
        inactive-color "#8c9199"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#9ccbfb"
        inactive-color "#8c9199"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#9ccbfb"
        inactive-color "#101418"
        urgent-color   "#ffb4ab"
    }
    insert-hint {
        color "#9ccbfb80"
    }
}
overview {
	backdrop-color "#101418"
}

recent-windows {
    highlight {
        active-color "#9ccbfb"
        urgent-color "#ffb4ab"
    }
}
