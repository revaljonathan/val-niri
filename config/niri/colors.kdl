layout {
	background-color "#111318"

    focus-ring {
        active-color "#bdc7dc"
        inactive-color "#8e9199"
        urgent-color   "#ffb4ab"
    }
    tab-indicator {
        active-color   "#a7c8ff"
        inactive-color "#8e9199"
