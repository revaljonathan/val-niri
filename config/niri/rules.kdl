recent-windows {
    binds {
        Mod+Tab         { next-window  scope="workspace"; }
        Mod+Shift+Tab   { previous-window scope="workspace"; }
    }
}

window-rule {
    draw-border-with-background false
}

blur {
    passes 3
    offset 3
    noise 0.03
    saturation 1.7
}

window-rule {
  match title="Brave"
  open-on-workspace "3"
  open-maximized true
}


window-rule {
    match app-id="[Ss]team"
    open-floating false
}

window-rule {
    match app-id="steam_app_2719093765"
    open-floating false
}

window-rule {
    match title="[Aa]rknights"
    open-floating false
    open-fullscreen true
}

window-rule {
  match title="Helium"
  open-maximized true
}


window-rule {
  match title="LimbusCompany"
  open-maximized true
}

window-rule {
    match app-id="clipse$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="[Vv]esktop"
    open-floating false
    background-effect {
        blur true
    } 
    popups {
        geometry-corner-radius 0
        background-effect {
            blur true
        }
    }

}


window-rule {
    match app-id="imv$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
}

window-rule {
    match app-id="xdg-desktop-portal-gnome"
    background-effect {
        blur true
    }
}
window-rule {
    match app-id="kitty"
    background-effect {
        saturation 0.95
        blur true
    }
}

window-rule {
    match app-id="org.pwmt.zathura"
    background-effect {
        blur true
        saturation 0.8
    }
}
window-rule {
    match app-id="nwg-look"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="calcurse$"
    open-floating true
    default-column-width { fixed 922; }
    default-window-height { fixed 1150; }
    background-effect {
        blur true
        saturation 0.85
    }
}


window-rule {
    match app-id="kittyfloat$"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 700; }
    default-floating-position x=0 y=10 relative-to="bottom"
}

window-rule {
    match app-id="xdg-desktop-portal-gtk"
    background-effect {
        blur true
    }
    popups {
        geometry-corner-radius 0
        background-effect {
            blur true
        }
    }
   
    min-width 952
    min-height 576 
    max-width 952
    max-height 1156
    
    open-floating true
}
layer-rule {
    match namespace="waybar"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="[Ll]xpolkit"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="pavucontrol-qt"
    opacity 0.85
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 500; }
    default-floating-position x=10 y=10 relative-to="top-right"
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="[Nn]autilus"
    background-effect {
        blur true
    }
    popups {
        geometry-corner-radius 0
        background-effect {
            blur true
        }
    }
}

window-rule {
    match app-id="[Tt]hunar"
    background-effect {
        blur true
    }
    popups {
        geometry-corner-radius 0
        background-effect {
            blur true
        }
    }
}

window-rule {
    match app-id="^zen"
    draw-border-with-background false
    background-effect {
        blur true
    }
}


layer-rule {
    match namespace="^rofi$"
    background-effect {
        blur true
        saturation 0.9
        xray false
    }
}

layer-rule {
    match namespace="^notifications$"
    background-effect {
        blur true
        xray false
    }
}

window-rule {
  match title="New Tab - Helium"
  opacity 0.88
  background-effect {
      blur true
      saturation 0.85
  }
}
window-rule {
  match app-id="[Ss]potify$"
  opacity 0.85
  open-maximized true
  open-on-workspace "4"
  background-effect {
      blur true
  }
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}
