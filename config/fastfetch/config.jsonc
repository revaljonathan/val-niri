{
    "$schema":"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.jso",
    "logo": {
    "type": "auto",
        "source": "none",
        "position": "left",
    //        "width": 15,
    // "height": 4,
    "padding": {
        "top": 1,
        "left": 0,
        "right": 2,
        "bottom": 0
        }
},
    // "color": {
    //     "1": "#eed49f",
    //     "2": "#e5c890",
    //     "6": "#f5a97f",
    //     "7": "#fab387",
    //     "8": "#f9e2af",
    //     "9": "#ef9f76"
    // },
    "display": {
    	"stat": false,
        "size": {
        "binaryPrefix": "jedec"
    },
        "separator": " "
    },
    
"modules": [

  
     {
			"type": "os",
			"key": "OS:     ",
			"keyColor": "blue"
		},
		{
			"type": "kernel",
			"key": "Kernel: ",
			"format": "{1} {2}",
			"keyColor": "blue"
		},
		{
			"type": "packages",
			"key": "Packs:  ",
			"keyColor": "blue"
		},
		{
			"type": "wm",
			"key": "WM:     ",
			"keyColor": "blue"
		},
		{
			"type": "lm",
			"key": "Greeter:",
			"keyColor": "blue"
		},
		{
			"type": "icons",
			"key": "Icons:  ",
			"keyColor": "blue",
      "format": "{icons2}"
		},
		{
			"type": "disk",
			"key": "Disk:     ",
			"keyColor": "magenta"
		},
		{
			"type": "brightness",
			"key": "Backlight:",
			"keyColor": "magenta"
		},
		{
			"type": "battery",
			"key": "Battery:  ",
			"keyColor": "magenta"
		},
		{
			"type": "terminal",
			"key": "Term:     ",
			"keyColor": "magenta"
		},
		{
			"type": "terminalfont",
			"key": "Font:     ",
			"keyColor": "magenta"
		},
    {
			"type": "font",
			"key": "Font:     ",
			"keyColor": "magenta"
		},
		{
			"type": "shell",
			"key": "Shell:    ",
			"keyColor": "magenta"
		},
		{
			"type": "host",
			"key": "Host:   ",
			"keyColor": "cyan"
		},
		{
			"type": "cpu",
			"key": "CPU:    ",
			"keyColor": "cyan",
      "format": "{name}"
		},
		{
			"type": "gpu",
			"key": "GPU:    ",
			"keyColor": "cyan",
      "format": "{vendor} {name}"
		},
		{
			"type": "display",
			"key": "Display:",
			"keyColor": "cyan",
      "format": "{width}x{height} in {inch}\", {refresh-rate}Hz"
		},
		{
			"type": "memory",
			"key": "Memory: ",
			"keyColor": "cyan"
		},
		{
			"type": "swap",
			"key": "Swap:   ",
			"keyColor": "cyan",
      "separate": true
		},
		{
			"type": "uptime",
			"key": "Uptime: ",
			"keyColor": "cyan"
		},
        {
    "type": "command",
    "key": "Age:    ",
    "keyColor": "cyan",
    "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
},
		// {
		// 	"type": "custom",
		// 	"format": "         \u001b[1m\u001b[31m  \u001b[1m\u001b[32m  \u001b[1m\u001b[33m  \u001b[1m\u001b[34m  \u001b[1m\u001b[35m  \u001b[1m\u001b[36m  \u001b[1m\u001b[37m  \u001b[1m\u001b[30m    "
		// }

]
    
}
