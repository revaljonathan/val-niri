{
    "$schema":"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.jso",
    "logo": {
    "type": "auto",
        "source": "/home/reval/.config/fastfetch/cat.txt",
        "position": "left",
    //        "width": 15,
    // "height": 4,
    "padding": {
        "top": 0,
        "left": 0,
        "right": 2,
        "bottom": 0
        }
},
    "display": {
    	"stat": false,
        "size": {
        "binaryPrefix": "jedec"
    },
        "separator": " "
    },
    
"modules": [	
    {
			"type": "title",
			"format": "{1}@{2}",
    },
		{
			"type": "kernel",
			"key": "Kernel: ",
			"format": "{1} {2}",
			"keyColor": "red"
		},
		{
			"type": "wm",
			"key": "WM:     ",
			"keyColor": "yellow"
		},
		{
			"type": "shell",
			"key": "Shell:  ",
			"keyColor": "green"
		},
		{
			"type": "cpu",
			"key": "CPU:    ",
			"keyColor": "blue",
      "format": "{name}"
		},
		{
			"type": "custom",
			"key": "GPU:    ",
			"keyColor": "magenta",
      "format": "NVIDIA GeForce RTX 5050 / Mobile"
		},
		{
			"type": "memory",
			"key": "Memory: ",
			"keyColor": "cyan"
		},
		{
			"type": "uptime",
			"key": "Uptime: ",
			"keyColor": "cyan"
		}
]
    
}
