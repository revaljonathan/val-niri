{
    "layer": "top",
    "height": 32,
    "width": 1920,
    "spacing": 4,

    "modules-left": [
        "clock",
        "network",
        "custom/separator-open",
        "mpris",
        "custom/separator",
        "battery"
    ],

    "modules-center": [
        "niri/workspaces"
    ],

    "modules-right": [
        "memory",
        "group/cpu",
        "pulseaudio#microphone",
        "pulseaudio",
        "backlight"
    ],

    "custom/separator": {
        "format": "]",
        "interval": "once",
        "tooltip": false
    },

    "custom/separator-open": {
        "format": "[",
        "interval": "once",
        "tooltip": false
    },

    "niri/window": {
        "format": "{}",
        "tooltip": true,
        "separate-outputs": true
    },

    "niri/workspaces": {
        "format": "[{icon}]"
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "[  {:%H:%M} ]"
    },

    "cpu": {
        "format": "[  {usage}% ",
        "tooltip": false
    },

    "memory": {
        "format": "[  {used:0.1f}GiB ]"
    },

    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": " {temperatureC}°C ]",
        "format-icons": ["󰉬", "", "󰉪"]
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "[ {icon} {percent}% ]",
        "format-icons": ["", "", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "[ {icon} {capacity}% ]",
        "format-full": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "on-click": "kitty -e btop"
    },

    "battery#bat2": {
        "bat": "BAT2"
    },

    "network": {
        "format-wifi": "[  {essid} ]",
        "format-ethernet": "{ipaddr}/{cidr} 󰊗",
        "tooltip-format": "{ifname} via {gwaddr} 󰊗",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "󱛅",
        "on-click": "~/.local/bin/wifi.sh"
    },

    "pulseaudio": {
        "format": "[  {source_volume}% ]",
        "format-muted": "󰅶",
        "on-click": "pavucontrol"
    },

    "pulseaudio#microphone": {
        "format": "[ {format_source} {source_volume}% ]",
        "format-source": "",
        "format-source-muted": "",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
        "tooltip-format": "{source_desc} | {source_volume}%"
    },

    "group/cpu": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "temperature"
        ]
    },

    "custom/weather": {
        "format": "{}°C",
        "tooltip": true,
        "interval": 5400,
        "exec": "wttrbar --nerd --hide-conditions --date-format '%m/%d' --mph --location=Semarang",
        "return-type": "json"
    },

    "mpris": {
        "format": "{player_icon} {title}",
        "max-length": 30,
        "format-paused": "{status_icon} <i>{artist} - {title}</i>",
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "",
            "chromium": ""
        },
        "status-icons": {
            "paused": "⏸"
        }
    },

    "group/mprisbat": {
        "orientation": "horizontal",
        "modules": [
            "mpris",
            "battery"
        ]
    }
}
