{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 34, // Waybar height (to be removed for auto height)
    "width": 1920, // Waybar width
    "spacing": 6, // Gaps between modules (4px)
    "margin-top": 1,
    "margin-bottom": 1,

    "modules-left": [
        "niri/workspaces",
        "mpris",
    ],

    "modules-center": [
        "custom/weather",
        "clock"
    ],

    "modules-right": [
        "custom/recorder",
        "battery",
        "group/syst",
        "group/sounds",
        "group/hw",
        "custom/dunst",
        "custom/caf-waybar"
    ],

"custom/caf-waybar": {
    "exec": "sh -c 'pgrep sleep.sh >/dev/null && echo \"\" || echo \" caffeinated\"'",
    "signal": 13,
    "format": "{}",
    "tooltip": false
}, 

"niri/workspaces": {
    "on-click": "activate",
    "all-outputs": true,
    "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": [],
        "4": [],
        "5": []
    },
    "format": "{icon}"
},

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": " {:%a, %d %b %H:%M}",
        "format-alt": " {:%H:%M}",
        "on-click-right": "~/.local/bin/cal.sh curr",
        "on-scroll-up": "~/.local/bin/cal.sh next",
        "on-scroll-down": "~/.local/bin/cal.sh prev"
    },

    "cpu": {
        "format": " {usage}%",
        "on-click": "kitty -e btop",
        "tooltip": false
    },

    "memory": {
        "format": " {used:0.1f}GiB",
    },

    "temperature": {
        // "thermal-zone": 2,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": " {temperatureC}°C",
        "format-icons": ["󰉬", "", "󰉪"]
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": ["", "", ""],
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-discharging": "{icon} {capacity}% - {time}",
        "format-full": "{capacity}% {icon}",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        //"format-alt": "{icon} {time}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""],
    },

    "battery#bat2": {
        "bat": "BAT2"
    },

    "network": {
        "max-length": 15,
        "format-wifi": "",
        "format-ethernet": "",
        "tooltip-format": "Network Information\n\nSSID  : {essid}\nIP    : {ipaddr}\nBand  : {frequency} MHz\nSignal: {signalStrength}%   \nvia   : {ifname}",
        "format-linked": "{ifname} (No IP) 󰊗",
        "format-disconnected": "󱛅",
        "on-click": "~/.local/bin/wifi.sh"
    },

    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": " {volume}%",
        //"format-bluetooth": "{volume}% {icon} {format_s" , //ource}",
        //"format-bluetooth-muted": "󰅶 {icon} {format_source}",
        "format-muted": "󰅶", //{format_source}",
        //"format-source": " {volume}%",
        //"format-source-muted": " ",
        "on-click": "pavucontrol-qt"
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-source-mute @DEFAULT_SOURCE@ toggle",
        "on-scroll-up": "pactl set-source-volume @DEFAULT_SOURCE@ +5%",
        "on-scroll-down": "pactl set-source-volume @DEFAULT_SOURCE@ -5%",
        "tooltip-format": "{source_desc} | {source_volume}%"
    },

    "custom/weather": {
        "format": "{}°C",
        "tooltip": true,
        "interval": 5400,
        "exec": "wttrbar --nerd --hide-conditions --date-format '%m/%d' --mph --location=Semarang",
        "return-type": "json",
    },

    "group/cpu": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "temperature"
        ]
    },

    // "custom/steam": {
    //     "exec": "sh -c 'pgrep steam >/dev/null && echo \"\" || echo \"\"'",
    //     "on-click-right": "killall steam",
    //     "interval": 30
    // },
    // "custom/vesktop": {
    //     "exec": "pgrep vesktop >/dev/null && echo ''",
    //     "on-click-right": "killall vesktop",
    //     "interval": 30
    // },
    // "custom/spotify": {
    //     "exec": "pgrep spotify >/dev/null && echo ''",
    //     "on-click-right": "killall spotify",
    //     "interval": 30
    // },

    "mpris": {
        "format": "{player_icon} {title} - {artist}",
        "max-length": 30,
        "tooltip": false,
        "format-paused": "{status_icon} <i>{title} - {artist}</i>",
        "player-icons": {
            "default": "▶",
        },
        "status-icons": {
            "paused": "⏸"
        }
    },

    "custom/dunst": {
    "format": "{}",
    "exec": "dunstctl is-paused | grep -q true && echo 'DND' || echo ''",
    "signal": 8
    },

    "custom/recorder": {
    "format": "Rec 󰑊",
    "exec": "pgrep -x wf-recorder",
    "signal": 9
    },

    "group/hw": {
        "orientation": "horizontal",
        "modules": [
            "backlight",
            "network",

        ]
    },

        "group/bg": {
        "orientation": "horizontal",
        "modules": [
            "custom/steam",
            "custom/vesktop",
            "custom/spotify"
        ]
    },

    "group/sounds": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio#microphone",
        ]
    },
        "group/syst": {
        "orientation": "horizontal",
        "modules": [
          "cpu",
          "temperature",
          "memory"
        ]
    }
}
