* {
    primary: #9bc2fe;
    primary-fixed: #d4e3ff;
    primary-fixed-dim: #a5c8fe;
    on-primary: #002f5b;
    on-primary-fixed: #001c39;
    on-primary-fixed-variant: #214876;
    primary-container: #2e5382;
    on-primary-container: #ffffff;
    secondary: #bcc7dc;
    secondary-fixed: #d8e3f8;
    secondary-fixed-dim: rgba(215, 231, 255, 0.8);
    on-secondary: #252f3f;
    on-secondary-fixed: #111c2b;
    on-secondary-fixed-variant: #3d4758;
    secondary-container: #485264;
    on-secondary-container: #ffffff;
    tertiary: #d9bde3;
    tertiary-fixed: #f6d9ff;
    tertiary-fixed-dim: #d9bde3;
    on-tertiary: #3b2744;
    on-tertiary-fixed: #271430;
    on-tertiary-fixed-variant: #543f5e;
    tertiary-container: #604a69;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #660004;
    error-container: #a7060f;
    on-error-container: #ffffff;
    surface: #111318;
    on-surface: #e1e2e9;
    on-surface-variant: #c3c6cf;
    outline: #8d9199;
    outline-variant: #4e525a;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e1e2e9;
    inverse-on-surface: #2e3035;
    inverse-primary: #3b608f;
    surface-dim: #14171cCC;
    surface-bright: #393b41;
    surface-container-lowest: #0a0d11;
    surface-container-low: #191c21;
    surface-container: #1f2126;
    surface-container-high: #292c31;
    surface-container-highest: #34373c;
}
