* {
    primary: #bac3ff;
    primary-fixed: #dee0ff;
    primary-fixed-dim: #bac3ff;
    on-primary: #192358;
    on-primary-fixed: #0a154b;
    on-primary-fixed-variant: #384278;
    primary-container: #576199;
    on-primary-container: #ffffff;
    secondary: #c3c5dd;
    secondary-fixed: #dfe1f9;
    secondary-fixed-dim: rgba(237, 239, 255, 0.8);
    on-secondary: #242739;
    on-secondary-fixed: #171a2c;
    on-secondary-fixed-variant: #424558;
    secondary-container: #616378;
    on-secondary-container: #ffffff;
    tertiary: #e5bad8;
    tertiary-fixed: #ffd7f1;
    tertiary-fixed-dim: #e5bad8;
    on-tertiary: #3b1e35;
    on-tertiary-fixed: #2d1228;
    on-tertiary-fixed-variant: #5c3b54;
    tertiary-container: #7d5973;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #580003;
    error-container: #c32220;
    on-error-container: #ffffff;
    surface: #121318;
    on-surface: #e8e6ed;
    on-surface-variant: #c6c5d0;
    outline: #96959f;
    outline-variant: #63646d;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e3e1e9;
    inverse-on-surface: #303036;
    inverse-primary: #4a548a;
    surface-dim: #15161cCC;
    surface-bright: #3d3d43;
    surface-container-lowest: #0b0b10;
    surface-container-low: #1c1c21;
    surface-container: #222228;
    surface-container-high: #2d2d33;
    surface-container-highest: #38383e;
}
