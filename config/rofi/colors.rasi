* {
    primary: #95cdf7;
    primary-fixed: #c9e6ff;
    primary-fixed-dim: #95cdf7;
    on-primary: #00324b;
    on-primary-fixed: #001e2f;
    on-primary-fixed-variant: #004c6e;
    primary-container: #12577b;
    on-primary-container: #ffffff;
    secondary: #b7c9d9;
    secondary-fixed: #d3e5f5;
    secondary-fixed-dim: rgba(196, 227, 251, 0.8);
    on-secondary: #20313d;
    on-secondary-fixed: #0c1d29;
    on-secondary-fixed-variant: #384956;
    secondary-container: #435461;
    on-secondary-container: #ffffff;
    tertiary: #cec0e8;
    tertiary-fixed: #eaddff;
    tertiary-fixed-dim: #cec0e8;
    on-tertiary: #332949;
    on-tertiary-fixed: #201635;
    on-tertiary-fixed-variant: #4c4163;
    tertiary-container: #574c6e;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #660004;
    error-container: #a7060f;
    on-error-container: #ffffff;
    surface: #101417;
    on-surface: #dfe3e8;
    on-surface-variant: #c1c7ce;
    outline: #8b9198;
    outline-variant: #4c5358;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dfe3e8;
    inverse-on-surface: #2d3135;
    inverse-primary: #256489;
    surface-dim: #13181cCC;
    surface-bright: #383c40;
    surface-container-lowest: #090d11;
    surface-container-low: #181c20;
    surface-container: #1e2225;
    surface-container-high: #282c30;
    surface-container-highest: #33373b;
}
