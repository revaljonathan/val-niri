* {
    primary: #92c6fb;
    primary-fixed: #cee5ff;
    primary-fixed-dim: #9ccbfb;
    on-primary: #003151;
    on-primary-fixed: #001d33;
    on-primary-fixed-variant: #104a73;
    primary-container: #21557f;
    on-primary-container: #ffffff;
    secondary: #b9c8da;
    secondary-fixed: #d5e4f7;
    secondary-fixed-dim: rgba(205, 229, 253, 0.8);
    on-secondary: #22303e;
    on-secondary-fixed: #0e1d2a;
    on-secondary-fixed-variant: #3a4857;
    secondary-container: #455363;
    on-secondary-container: #ffffff;
    tertiary: #d4bfe6;
    tertiary-fixed: #efdbff;
    tertiary-fixed-dim: #d4bfe6;
    on-tertiary: #372847;
    on-tertiary-fixed: #231533;
    on-tertiary-fixed-variant: #504061;
    tertiary-container: #5b4b6c;
    on-tertiary-container: #ffffff;
    error: #ffb4ab;
    on-error: #660004;
    error-container: #a7060f;
    on-error-container: #ffffff;
    surface: #101418;
    on-surface: #e0e2e8;
    on-surface-variant: #c2c7cf;
    outline: #8c9199;
    outline-variant: #4d5259;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #e0e2e8;
    inverse-on-surface: #2d3135;
    inverse-primary: #30628c;
    surface-dim: #13181dCC;
    surface-bright: #383c40;
    surface-container-lowest: #0a0d11;
    surface-container-low: #191c20;
    surface-container: #1e2226;
    surface-container-high: #292c30;
    surface-container-highest: #33373b;
