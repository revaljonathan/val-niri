configuration {
    modes:              "drun";
    sorting-method:     "normal";
    show-icons:         true;
    terminal:           "kitty";
    editor:             "micro";
    matching:           "regex";
    drun-match-fields:  "name";
    /*display-run:        "Window:";
    display-ssh:        " SSH:";
    display-drun:       "󰀻 Apps:";
        display-emoji:		"󱃞 Emoji";
        */
     kb-move-char-forward: "Right";
    kb-move-char-back: "Left";
    kb-mode-next: "Alt+Right";
    kb-mode-previous: "Alt+Left";
  window-format: "{n} {t}";
    drun-display-format: "{name}";   
}
@theme "mocha"

* {
    bg0:     #181825;
    bg1:     #181825;
    bg2:     #313244;
    bg3:     #45475a;
    fg0:     #cdd6f4;
    fg1:     #bac2de;
    fg2:     #6c7086;
    red:     #f38ba8;
    green:   #a6e3a1;
    yellow:  #f9e2af;
    blue:    #89b4fa;
    magenta: #cba6f7;
    cyan:    #94e2d5;
    peach:   #fab387;

    accent:  @peach;
    urgent:  @yellow;

    /* Semantic aliases */
    background-color:   transparent;
    text-color:         @fg0;
}

window {
    width:            520px;
    background-color: @bg0;
    border:           1px;
    border-color:     @fg2;
    border-radius:    0px;
    padding:          0;
}
/* ── Main box ─────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          0;
    padding:          12px;
}

/* ── Input bar ────────────────────────────────────────────────────────── */
inputbar {
    background-color: @bg0;
    padding:          1px 10px;
    margin:           0 0 10px 0;
    children:         [ prompt, entry ];
    spacing:          6px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "JetBrains Mono Bold 12";
}

entry {
    background-color: transparent;
    text-color:       @fg0;
    placeholder:      "Search…";
    placeholder-color: @fg2;
    font:             "JetBrains Mono 12";
    cursor:           text;
}



button {
    background-color: @bg2;
    text-color:       @fg0;
    border-radius:    1px;
    cursor:           pointer;
}

button selected {
    background-color: @accent;
    text-color:       @bg0;
}

/* ── List view ────────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    lines:            8;
    spacing:          4px;
    fixed-height:     false;
}

scrollbar {
    width:            4px;
    handle-width:     4px;
    background-color: @bg2;
    handle-color:     @accent;
    border-radius:    0px;
}

/* ── List elements ────────────────────────────────────────────────────── */
element {
    background-color: transparent;
    text-color:       @fg0;
    border-radius:    0px;
    padding:          8px 10px;
    spacing:          8px;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg0;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active {
    background-color: transparent;
    text-color:       @cyan;
}

element selected.normal {
    background-color: @fg2;
    text-color:       @bg0;
    border-color:     @accent;
}

element selected.urgent {
    background-color: @bg3;
    text-color:       @urgent;
    border-color:     @urgent;
}

element selected.active {
    background-color: @bg3;
    text-color:       @cyan;
    border-color:     @cyan;
}

element-icon {
    background-color: transparent;
    size:             24px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    font:             "JetBrains Mono 12";
}

/* ── Message ──────────────────────────────────────────────────────────── */
message {
    background-color: @bg2;
    border-radius:    0px;
    padding:          8px 12px;
    margin:           0 0 10px 0;
}

textbox {
    background-color: transparent;
    text-color:       @fg2;
    font:             "JetBrains Mono 1i";
}
