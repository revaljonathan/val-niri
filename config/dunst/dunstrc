[global]
separator_color= frame
transparency = 20
frame_color = "#96959f"
frame_width = 0
highlight = "#e5bad8"
font = JetBrainsMono Nerd font 13
width = (300, 700)
height = (50, 500)
progress_bar = true
progress_bar_height = 10
progress_bar_corner_radius = 4
progress_bar_frame_width = 1
progress_bar_min_width = 300
progress_bar_max_width = 300
padding = 6
origin = top-right
format = "<b>%s</b>\n<span foreground='#9399b2ff'>%a</span>\n%b"


[urgency_low]
    background = "#222228BF"
    foreground = "#e8e6ed"

[urgency_normal]
    background = "#222228BF"
    foreground = "#e8e6ed"

[urgency_critical]
    background = "#c32220BF"
    foreground = "#ffffff"

[volume_notifications]
    appname = volume
    summary = *
    history_ignore = true
    set_stack_tag = volume
    appname = volume

[brightness]
    appname = brightness
    summary = *
    history_ignore = true
    set_stack_tag = brightness


