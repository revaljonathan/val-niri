set default-fg                "{{colors.on_surface.default.rgba}}"
set default-bg                "{{colors.surface.default.rgba | set_alpha: 0.8 }}"
set completion-bg             "{{colors.surface_container.default.rgba}}"
set completion-fg             "{{colors.on_surface.default.rgba}}"
set completion-highlight-bg   "{{colors.primary.default.rgba}}"
set completion-highlight-fg   "{{colors.on_primary.default.rgba}}"
set completion-group-bg       "{{colors.surface_container_lowest.default.rgba}}"
set completion-group-fg       "{{colors.on_surface.default.rgba}}"
set statusbar-fg              "{{colors.on_surface.default.rgba}}"
set statusbar-bg              "{{colors.surface_container_lowest.default.rgba}}"
set inputbar-fg               "{{colors.on_surface.default.rgba}}"
set inputbar-bg               "{{colors.surface.default.rgba}}"
set notification-bg           "{{colors.surface.default.rgba}}"
set notification-fg           "{{colors.on_surface.default.rgba}}"
set notification-error-bg     "{{colors.surface.default.rgba}}"
set notification-error-fg     "{{colors.error.default.rgba}}"
set notification-warning-bg   "{{colors.surface.default.rgba}}"
set notification-warning-fg   "{{colors.tertiary.default.rgba}}"
set recolor                   "true"
set recolor-lightcolor        "{{colors.surface.default.rgba | set_alpha: 0.25 }}"
set recolor-darkcolor         "{{colors.on_surface.default.rgba}}"
set index-fg                  "{{colors.on_surface.default.rgba}}"
set index-bg                  "{{colors.surface.default.rgba | set_alpha: 0.8 }}"
set index-active-fg           "{{colors.on_surface.default.rgba}}"
set index-active-bg           "{{colors.surface_container.default.rgba}}"
set render-loading-bg         "{{colors.surface.default.rgba}}"
set render-loading-fg         "{{colors.on_surface.default.rgba}}"
set highlight-color           "{{colors.outline.default.rgba | set_alpha: 0.6}}"
set highlight-fg              "{{colors.surface.default.rgba}}"
set highlight-active-color    "{{colors.surface.default.rgba}}"

set recolor-reverse-video "false"
